{
  "name": "@singleton-sd/cms-oauth-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared GitHub OAuth proxy for Decap CMS admin on Singleton SD marketing sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleton-sd/cms-oauth-kit.git"
  },
  "packageManager": "pnpm@9.15.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/github-oauth.spec.js dist/login-script.spec.js",
    "start": "func start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@azure/functions": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
